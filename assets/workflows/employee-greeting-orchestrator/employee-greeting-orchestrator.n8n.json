            "parameters": {
                "mode": "append",
                "numberInputs": 3
            }
        },
        {
            "id": "node-aggregate-results",
            "name": "Aggregate All Results",
            "type": "n8n-nodes-base.aggregate",
            "typeVersion": 1,
            "position": [
                2400,
                300
            ],
            "parameters": {
                "aggregate": "aggregateAllItemData",
                "destinationFieldName": "dispatchedEmails"
