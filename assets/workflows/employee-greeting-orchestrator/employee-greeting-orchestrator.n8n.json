        },
        {
            "id": "node-build-summary",
            "name": "Build Summary",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                2620,
                300
            ],
            "executeOnce": true,
            "parameters": {
                "mode": "runOnceForAllItems",
                "jsCode": "// Build summary report of all logged emails\nconst emails = $input.all().map(i => i.json).filter(i => i.dispatchedEmails);\n\nlet allDispatched = [];\nfor (const item of $input.all()) {\n  const dispatched = item.json.dispatchedEmails;\n  if (Array.isArray(dispatched)) {\n    allDispatched = allDispatched.concat(dispatched);\n  }\n}\n\nconst totalEmails = allDispatched.length;\nconst anniversaryCount = allDispatched.filter(e => e.type === 'anniversary').length;\nconst birthdayCount = allDispatched.filter(e => e.type === 'birthday').length;\n\n// Count unique input employees from Parse CSV node\nconst totalInput = $('Parse CSV').first().json.totalEmployees || 0;\n\nconsole.log(`M4.achieved: All greeting emails logged successfully — ${totalEmails} emails logged (${anniversaryCount} anniversary, ${birthdayCount} birthday) for ${totalInput} input employees`);\n\nreturn [{ json: {\n  summary: {\n    totalInputEmployees: totalInput,\n    totalEmailsLogged: totalEmails,\n    anniversaryEmailsLogged: anniversaryCount,\n    birthdayEmailsLogged: birthdayCount,\n    details: allDispatched\n  }\n} }];"
            }
        },
        {
            "id": "node-respond-success",
            "name": "Respond — Success",
            "type": "n8n-nodes-base.respondToWebhook",
            "typeVersion": 1.5,
            "position": [
                2840,
