            }
        },
        {
            "id": "node-log-birthday-both",
            "name": "Log Birthday Email (Both)",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                1960,
                460
            ],
            "parameters": {
                "mode": "runOnceForEachItem",
                "jsCode": "// LOG_BIRTHDAY_EMAIL (dual-match): Replace this node with actual email sending when email provider is configured\nconst name = $json.name;\nconst email = $json.email;\nconst dateOfBirth = $json.dateOfBirth;\nconsole.log(`[BIRTHDAY EMAIL] Would send Birthday Greeting email to: ${name} <${email}>, dateOfBirth: ${dateOfBirth}`);\nreturn [{ json: { name, email, type: 'birthday', logged: true } }];"
            }
